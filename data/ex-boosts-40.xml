	<Modifier id="ENI_EX_BOOST_MERCANTILISM" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_GRANT_PROGRESSION" permanent="true" run-once="true">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLAYER_HAS_AT_LEAST_NUM_GOSSIPS">
				<Argument name="GossipTypes">GOSSIP_DIPLOMACY_ACTION_STARTED01</Argument>
				<!-- Counts the endeavor ACTION, at any response level - confirmed in play 6 Aug: merely
				     ACCEPTING an endeavor fires it, not just choosing Support. That is deliberate. AQ's
				     Currency is the support-level deed (GOSSIP_DIPLOMACY_RESPONSE01 filtered on
				     DIPLOMACY_RESPONSE_SUPPORT), and Support costs far more Influence than Accept, so
				     the two deeds are not interchangeable and must not both read the same event.
				     Mercantilism is a very early Exploration civic - a small node, a small boost, so a
				     cheap deed is correct here. It cannot be tightened anyway: every shipped filter for
				     this gossip uses OtherPlayer with Self or Other and never an identity, and there is
				     no precedent at all for requiring that YOU initiated. -->
				<Argument name="GOSSIP_DIPLOMACY_ACTION_STARTED01">Hash,OtherPlayer,Other,Hash,DiplomacyActionGroup,DIPLOMACY_ACTION_GROUP_ENDEAVOR</Argument>
				<Argument name="DuplicateCount">2</Argument>
				<Argument name="AfterInit">True</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="Amount">1</Argument>
		<Argument name="BoostPercentage">40</Argument>
		<Argument name="SystemType">SYSTEM_CULTURE</Argument>
		<Argument name="FreeProgressionType">FREE_PROGRESSION_BOOST_SPECIFIC</Argument>
		<Argument name="NodeType">NODE_CIVIC_EX_MAIN_MERCANTILISM</Argument>
	</Modifier>
