				<Argument name="GOSSIP_DIPLOMACY_ACTION_STARTED01">Hash,DiplomacyActionType,DIPLOMACY_ACTION_CS_LEVY_UNIT</Argument>
				<!-- Two levy ACTIONS, which may be the same City-State twice - the count cannot be
				     constrained to distinct or to particular City-States. Every shipped filter string for
				     this gossip uses only DiplomacyActionType / DiplomacyActionGroup / OtherPlayer, and
				     OtherPlayer takes Self or Other, never an identity; DuplicateCount counts occurrences,
				     not distinct subjects. There is no levy-counting requirement either. Two actions is
				     the right ask anyway: it costs Influence twice and does not depend on how many
				     City-States the map happened to give you. -->
				<Argument name="DuplicateCount">2</Argument>
				<Argument name="AfterInit">True</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="Amount">1</Argument>
